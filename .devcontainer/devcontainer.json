{
    "name": "EPAWM",
    "build": { "dockerfile": "Dockerfile" },
    "postCreateCommand": "uv sync --locked --all-groups",
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "charliermarsh.ruff",
                "eamodio.gitlens"
            ],
            "settings": {
                "python.defaultInterpreterPath": "/workspaces/.venv/bin/python",
                "python.terminal.activateEnvironment": false
            }
        }
    }
}